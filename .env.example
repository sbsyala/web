# ─────────────────────────────────────────────────────────────
#  Shakya Bajracharya Samaj Yala — Environment Variables
#  Copy this file to `.env` for local development.
#  On Vercel/Railway, add these in the project's Environment Variables UI.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Neon / Supabase / Railway / local)
# Example (Neon): postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret keys used to sign login sessions and hash passwords.
# IMPORTANT: Use long random strings in production (e.g. `openssl rand -hex 32`).
# Changing ADMIN_SECRET after launch will invalidate existing password hashes.
ADMIN_SECRET=change-me-to-a-long-random-string
MEMBER_SECRET=change-me-to-another-long-random-string
